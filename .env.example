# Copie para .env e ajuste. Não coloque segredos reais neste arquivo.

# Usuário dos containers (precisa ter escrita em dados/)
APP_UID=1000
APP_GID=1000

# Portas expostas no host
KAFKA_PORTA=9092
CONNECT_PORTA=8083
CONTROLE_PORTA=8001
CONSULTA_PORTA=8002
SIMULADOR_METRICS_PORT=9100

# Tópicos
TOPICO_EVENTOS=transportadora.carga.eventos.v1
TOPICO_DLQ=transportadora.carga.eventos-dlq.v1
TOPICO_PARTICOES=3
TOPICO_RETENCAO_MS=900000
TOPICO_SEGMENT_MS=60000
DLQ_RETENCAO_MS=86400000

# API de consulta: janela da projeção em memória (mesma retenção do tópico)
RETENCAO_PROJECAO_S=900

# API de controle
CONTROLE_API_KEY=troque-me
CONECTOR_NOME=arquivos-eventos-transportadora

# Simulador
SIMULADOR_CARGAS=3
SIMULADOR_INTERVALO_MS=500
SIMULADOR_DURACAO_S=0
SIMULADOR_MAX_EVENTOS=10
SIMULADOR_CONTINUO=false
SIMULADOR_PROB_FALHA=0.15

LOG_LEVEL=INFO
