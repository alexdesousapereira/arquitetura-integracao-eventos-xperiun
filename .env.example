# Copie para .env e ajuste. Não coloque segredos reais neste arquivo.

# Usuário dos containers (precisa ter escrita em dados/)
APP_UID=1000
APP_GID=1000

# Portas expostas no host
KAFKA_PORTA=9092
CONNECT_PORTA=8083
CONTROLE_PORTA=8001
CONSULTA_PORTA=8002
SIMULADOR_METRICS_PORT=9100

# Tópicos
TOPICO_EVENTOS=loja.pedido.eventos.v1
TOPICO_DLQ=loja.pedido.eventos-dlq.v1
TOPICO_PARTICOES=3
TOPICO_RETENCAO_MS=900000
TOPICO_SEGMENT_MS=60000
DLQ_RETENCAO_MS=86400000

# API de consulta: janela da projeção em memória (mesma retenção do tópico)
RETENCAO_PROJECAO_S=900

# API de controle
CONTROLE_API_KEY=troque-me
CONECTOR_NOME=arquivos-eventos-loja

# Simulador
SIMULADOR_PEDIDOS=3
SIMULADOR_INTERVALO_MS=500
# Segundos que cada pedido fica em um status antes de avançar (0 = sem espera; ex.: 10 na aula)
SIMULADOR_ATRASO_STATUS_S=0
SIMULADOR_DURACAO_S=0
SIMULADOR_MAX_EVENTOS=10
SIMULADOR_CONTINUO=false
SIMULADOR_PROB_FALHA=0.15

LOG_LEVEL=INFO

# Notificador (bot do Telegram). Vazios = modo demonstração: as mensagens só aparecem no log.
# Token: crie o bot com o @BotFather. Chat: veja README, seção "Bot de notificação".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICADOR_GRUPO=notificador
# latest = na primeira execução do grupo, só eventos novos; earliest = tudo que ainda está no tópico
NOTIFICADOR_OFFSET_INICIAL=latest
# Pausa entre mensagens (limite do Telegram: ~1/s por chat, ~20/min em grupos)
NOTIFICADOR_INTERVALO_S=1
