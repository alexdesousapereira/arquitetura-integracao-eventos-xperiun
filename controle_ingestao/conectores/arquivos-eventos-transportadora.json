{
  "connector.class": "io.streamthoughts.kafka.connect.filepulse.source.FilePulseSourceConnector",
  "tasks.max": "1",
  "topic": "transportadora.carga.eventos.v1",
  "fs.listing.class": "io.streamthoughts.kafka.connect.filepulse.fs.LocalFSDirectoryListing",
  "fs.listing.directory.path": "/data/eventos",
  "fs.listing.filters": "io.streamthoughts.kafka.connect.filepulse.fs.filter.RegexFileListFilter",
  "file.filter.regex.pattern": "^[^.].*\\.json$",
  "fs.listing.interval.ms": "1000",
  "fs.listing.task.delegation.enabled": "true",
  "fs.cleanup.policy.class": "io.streamthoughts.kafka.connect.filepulse.fs.clean.LocalMoveCleanupPolicy",
  "cleaner.output.succeed.path": "/data/backup",
  "cleaner.output.failed.path": "/data/erros",
  "tasks.reader.class": "io.streamthoughts.kafka.connect.filepulse.fs.reader.LocalBytesArrayInputReader",
  "tasks.halt.on.error": "false",
  "tasks.file.status.storage.class": "io.streamthoughts.kafka.connect.filepulse.state.KafkaFileObjectStateBackingStore",
  "tasks.file.status.storage.bootstrap.servers": "kafka:29092",
  "tasks.file.status.storage.topic": "_connect-file-pulse-status",
  "tasks.file.status.storage.topic.partitions": "1",
  "tasks.file.status.storage.topic.replication.factor": "1",
  "filters": "ParseJSON,RemoveMessage,SetKey",
  "filters.ParseJSON.type": "io.streamthoughts.kafka.connect.filepulse.filter.JSONFilter",
  "filters.ParseJSON.source": "message",
  "filters.ParseJSON.merge": "true",
  "filters.RemoveMessage.type": "io.streamthoughts.kafka.connect.filepulse.filter.ExcludeFilter",
  "filters.RemoveMessage.fields": "message",
  "filters.SetKey.type": "io.streamthoughts.kafka.connect.filepulse.filter.AppendFilter",
  "filters.SetKey.field": "$key",
  "filters.SetKey.value": "{{ $.carga_id }}",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "headers",
  "transforms.headers.type": "org.apache.kafka.connect.transforms.HeaderFrom$Value",
  "transforms.headers.fields": "correlation_id,event_type",
  "transforms.headers.headers": "correlation_id,event_type",
  "transforms.headers.operation": "copy",
  "errors.tolerance": "none"
}
