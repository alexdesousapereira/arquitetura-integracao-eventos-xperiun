{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transportadora.local/schemas/evento-carga/v1.json",
  "title": "EventoCarga",
  "description": "Evento do ciclo de vida de uma carga da transportadora (versão 1 do contrato).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "correlation_id",
    "carga_id",
    "payload"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "enum": [
        "carga.recebida",
        "carga.saiu_para_transporte",
        "carga.em_transito",
        "carga.saiu_para_entrega",
        "carga.entregue",
        "carga.entrega_falhou"
      ]
    },
    "event_version": { "const": 1 },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source": { "type": "string", "minLength": 1, "maxLength": 100 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "carga_id": { "type": "string", "pattern": "^CRG-[0-9A-F]{8}$" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "carga.recebida" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PayloadRecebida" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "carga.saiu_para_transporte" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PayloadSaiuParaTransporte" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "carga.em_transito" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PayloadEmTransito" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "carga.saiu_para_entrega" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PayloadSaiuParaEntrega" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "carga.entregue" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PayloadEntregue" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "carga.entrega_falhou" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PayloadEntregaFalhou" } } }
    }
  ],
  "$defs": {
    "Localidade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidade", "uf"],
      "properties": {
        "cidade": { "type": "string", "minLength": 1, "maxLength": 100 },
        "uf": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "VeiculoId": { "type": "string", "pattern": "^VEI-[0-9]{4}$" },
    "Tentativa": { "type": "integer", "minimum": 1, "maximum": 3 },
    "PayloadRecebida": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origem", "destino", "peso_kg", "descricao", "centro_distribuicao"],
      "properties": {
        "origem": { "$ref": "#/$defs/Localidade" },
        "destino": { "$ref": "#/$defs/Localidade" },
        "peso_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 30000 },
        "descricao": { "type": "string", "maxLength": 200 },
        "centro_distribuicao": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "PayloadSaiuParaTransporte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["veiculo_id", "previsao_entrega"],
      "properties": {
        "veiculo_id": { "$ref": "#/$defs/VeiculoId" },
        "previsao_entrega": { "type": "string", "format": "date-time", "pattern": "Z$" }
      }
    },
    "PayloadEmTransito": {
      "type": "object",
      "additionalProperties": false,
      "required": ["veiculo_id", "localizacao"],
      "properties": {
        "veiculo_id": { "$ref": "#/$defs/VeiculoId" },
        "localizacao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "cidade", "uf"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "cidade": { "type": "string", "minLength": 1, "maxLength": 100 },
            "uf": { "type": "string", "pattern": "^[A-Z]{2}$" }
          }
        }
      }
    },
    "PayloadSaiuParaEntrega": {
      "type": "object",
      "additionalProperties": false,
      "required": ["veiculo_id", "tentativa"],
      "properties": {
        "veiculo_id": { "$ref": "#/$defs/VeiculoId" },
        "tentativa": { "$ref": "#/$defs/Tentativa" }
      }
    },
    "PayloadEntregue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tentativa", "recebedor"],
      "properties": {
        "tentativa": { "$ref": "#/$defs/Tentativa" },
        "recebedor": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "PayloadEntregaFalhou": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tentativa", "motivo"],
      "properties": {
        "tentativa": { "$ref": "#/$defs/Tentativa" },
        "motivo": {
          "type": "string",
          "enum": ["DESTINATARIO_AUSENTE", "ENDERECO_NAO_ENCONTRADO", "RECUSADA"]
        }
      }
    }
  },
  "examples": [
    {
      "event_id": "3f0c8a52-6b1e-4c5e-9d7a-2f1b8e4c9a10",
      "event_type": "carga.recebida",
      "event_version": 1,
      "occurred_at": "2026-11-02T13:05:12.481Z",
      "source": "simulador-transportadora",
      "correlation_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "carga_id": "CRG-1A2B3C4D",
      "payload": {
        "origem": { "cidade": "Campinas", "uf": "SP" },
        "destino": { "cidade": "Belo Horizonte", "uf": "MG" },
        "peso_kg": 412.5,
        "descricao": "Eletrônicos - 12 volumes",
        "centro_distribuicao": "CD-CAMPINAS"
      }
    }
  ]
}
